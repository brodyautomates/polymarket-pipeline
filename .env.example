# Anthropic (required)
ANTHROPIC_API_KEY=sk-ant-...

# Polymarket CLOB API (optional — for live trading)
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=
POLYMARKET_PRIVATE_KEY=        # 64-hex wallet SIGNING key (0x...), NOT the API-key UUID
POLYMARKET_FUNDER_ADDRESS=     # Polymarket proxy wallet address that holds your USDC
POLYMARKET_SIGNATURE_TYPE=2    # 0=EOA, 1=email/magic login, 2=browser-wallet (MetaMask) proxy

# Twitter API v2 (optional — real-time news stream)
TWITTER_BEARER_TOKEN=

# Telegram Bot (optional — channel monitoring)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_IDS=

# NewsAPI.org (optional — broader news coverage)
NEWSAPI_KEY=

# Pipeline Settings
DRY_RUN=true
MAX_BET_USD=25
DAILY_LOSS_LIMIT_USD=100
EDGE_THRESHOLD=0.10

# V2 Settings
MAX_VOLUME_USD=500000
MIN_VOLUME_USD=1000
MATERIALITY_THRESHOLD=0.6
SPEED_TARGET_SECONDS=5

# Market-Data Trading Bot (bot.py) — needs NO paid API keys
STARTING_BANKROLL_USD=1000
BOT_STRATEGIES=favorite_longshot,mean_reversion
MAX_OPEN_POSITIONS=10
MAX_POSITION_PCT=0.05
MAX_EXPOSURE_PCT=0.50
MAX_SPREAD=0.04
MIN_LIQUIDITY_USD=5000
BOT_LOOP_INTERVAL_SECONDS=60
